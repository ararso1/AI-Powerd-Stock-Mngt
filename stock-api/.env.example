DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=1234
DB_DATABASE=stock_management
DB_SYNCHRONIZE=false
DB_LOGGING=false

PORT=3001

JWT_AT_SECRET=change-me-access-secret
JWT_RT_SECRET=change-me-refresh-secret
JWT_AT_EXPIRES_IN=1d
JWT_RT_EXPIRES_IN=7d

DB_SEED=true
SEED_ADMIN_EMAIL=admin@stock.local
SEED_ADMIN_PASSWORD=Admin@123

# Demo users (created by seed — password Demo@123):
#   admin@csolve.local      Admin
#   sales@csolve.local      Sales Representative
#   purchase@csolve.local   Purchaser
#   stock@csolve.local      Stock Keeper

# Comma-separated; http://localhost:3000 is always allowed for local frontend dev
CORS_ORIGIN=https://noblestore.net,http://localhost:3000

# Display currency (amounts are stored as decimal numbers; FX used for market prices)
CURRENCY=ETB
CURRENCY_SYMBOL=Br

# International coffee market prices (ICE Arabica KC via Yahoo; Robusta via Commodities-API or KC-ratio proxy)
# COMMODITIES_API_KEY=
# COMMODITIES_API_BASE_URL=https://commodities-api.com/api
# MARKET_YAHOO_KC=KC=F
# MARKET_YAHOO_RC=
# MARKET_SYNC_INTERVAL_MS=21600000
# MARKET_ALLOW_DEMO_FALLBACK=true
# MARKET_FALLBACK_USD_ETB=120
