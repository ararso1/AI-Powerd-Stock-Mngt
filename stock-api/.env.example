DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=1234
DB_DATABASE=stock_management
DB_SYNCHRONIZE=false
DB_LOGGING=false

PORT=3001

JWT_AT_SECRET=change-me-access-secret
JWT_RT_SECRET=change-me-refresh-secret
JWT_AT_EXPIRES_IN=1d
JWT_RT_EXPIRES_IN=7d

# Public frontend origin used in password-reset email links
FRONTEND_URL=http://localhost:3000
PASSWORD_RESET_EXPIRES_MINUTES=60

# SMTP for forgot-password emails (omit SMTP_HOST to log the reset link in API logs)
PASSWORD_RESET_EXPIRES_MINUTES=60
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=csolve2022@gmail.com
SMTP_PASS=dpth hvvh jfda vqoa
SMTP_FROM=csolve2022@gmail.com

DB_SEED=true
SEED_ADMIN_EMAIL=admin@efnanbusinessplc.com
SEED_ADMIN_PASSWORD=Admin@123

# Demo users (created by seed — password Demo@123):
#   admin@efnanbusinessplc.com      Admin
#   sales@efnanbusinessplc.com      Sales Representative
#   purchase@efnanbusinessplc.com   Purchaser
#   stock@efnanbusinessplc.com      Stock Keeper

# Comma-separated; http://localhost:3000 is always allowed for local frontend dev
CORS_ORIGIN=https://noblestore.net,http://localhost:3000

# Display currency (amounts are stored as decimal numbers; FX used for market prices)
CURRENCY=ETB
CURRENCY_SYMBOL=Br

# International coffee market prices (ICE Arabica KC via Yahoo; Robusta via Commodities-API or KC-ratio proxy)
# COMMODITIES_API_KEY=
# COMMODITIES_API_BASE_URL=https://commodities-api.com/api
# MARKET_YAHOO_KC=KC=F
